# Root .env.example for Human-in-the-Loop Decision Intelligence Platform
# Copy to .env and configure each service

# ── Backend ──────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hitl_decision_intelligence
N8N_WEBHOOK_URL=http://localhost:5678/webhook/decision-analysis
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET=your_jwt_secret_here

# Optional: Direct Groq fallback (only needed if n8n is offline)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Frontend ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# ── n8n ──────────────────────────────────────────────
# Configure GROQ_API_KEY inside n8n credentials / environment
# NEVER place the Groq API key in frontend code
