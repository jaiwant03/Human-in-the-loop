# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/hitl_decision_intelligence
# Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/hitl_decision_intelligence
MONGO_URI=mongodb://127.0.0.1:27017/hitl_decision_intelligence

# n8n Automation Webhook URL
# Point this to your active n8n Webhook node
N8N_WEBHOOK_URL=http://localhost:5678/webhook/decision-analysis

# Optional Direct Groq Fallback (If n8n is offline or unconfigured)
# The system automatically uses n8n first. If n8n is offline, this key allows direct fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Authentication Secret (if enabled)
JWT_SECRET=hitl_super_secret_jwt_key_2026
